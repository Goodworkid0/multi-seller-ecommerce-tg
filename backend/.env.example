DATABASE_URL=sqlite+aiosqlite:///./db.db
SECRET_KEY=your-super-secret-key-change-in-production
BOT_TOKEN=your-telegram-bot-token
WEBAPP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_AUTO_CREATE_TABLES=false
# Set true only for local/dev bootstrap without migrations.
# In production prefer Alembic migrations.
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_IPN_URL=https://your-domain.com/api/payments/nowpayments/webhook

# NowPayments Payout (auto-withdrawal) - DEPRECATED, using Tron hot wallet instead
NOWPAYMENTS_PAYOUT_EMAIL=your-nowpayments-account-email
NOWPAYMENTS_PAYOUT_PASSWORD=your-nowpayments-account-password
NOWPAYMENTS_PAYOUT_IPN_URL=https://your-domain.com/api/payments/nowpayments/payout-webhook

# Tron Hot Wallet (USDT TRC-20 payouts)
TRON_PRIVATE_KEY=your-tron-wallet-private-key-hex-no-0x
TRON_WALLET_ADDRESS=your-tron-wallet-address-starts-with-T
TRON_NETWORK=mainnet
