# Gimmick Backend Environment — PRODUCTION
# Copy to /var/www/gimmick/backend/.env and fill in real values

DATABASE_URL=sqlite+aiosqlite:///./gimmick.db
SECRET_KEY=CHANGE_ME_RUN_python3_-c_"import_secrets;print(secrets.token_urlsafe(64))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
WEBAPP_URL=https://YOUR_DOMAIN.com

# Production
ENVIRONMENT=production
ALLOWED_ORIGINS=https://YOUR_DOMAIN.com
DEBUG=false

# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=YOUR_KEY
NOWPAYMENTS_PUBLIC=YOUR_PUBLIC_KEY
NOWPAYMENTS_IPN_SECRET=YOUR_IPN_SECRET
NOWPAYMENTS_IPN_URL=https://YOUR_DOMAIN.com/api/payments/nowpayments/webhook
