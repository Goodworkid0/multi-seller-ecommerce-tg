[Unit]
Description=TGWeb FastAPI Backend
After=network.target

[Service]
User=web
Group=web
WorkingDirectory=/home/web/backend
Environment="PATH=/home/web/backend/venv/bin:/usr/bin"
EnvironmentFile=/home/web/backend/.env
ExecStart=/home/web/backend/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
