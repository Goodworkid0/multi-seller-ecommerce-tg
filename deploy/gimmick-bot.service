[Unit]
Description=TGWeb Telegram Bot
After=network.target tgweb-api.service

[Service]
User=web
Group=web
WorkingDirectory=/home/web/backend
Environment="PATH=/home/web/backend/venv/bin:/usr/bin"
EnvironmentFile=/home/web/backend/.env
ExecStart=/home/web/backend/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
